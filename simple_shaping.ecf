<?xml version="1.0" encoding="ISO-8859-1"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-23-0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.eiffel.com/developers/xml/configuration-1-23-0 http://www.eiffel.com/developers/xml/configuration-1-23-0.xsd" name="simple_shaping" uuid="5838DC2B-9045-41B4-9F5C-15690FA9124F" library_target="simple_shaping">
	<description>Text shaping for the simple_* ecosystem: bidi, itemization, glyph shaping and font fallback behind four swappable seams - DirectWrite-first, Noto emoji as images</description>
	<target name="simple_shaping">
		<root all_classes="true"/>
		<file_rule>
			<exclude>/EIFGENs$</exclude>
			<exclude>/spikes$</exclude>
			<exclude>/\..*$</exclude>
		</file_rule>
		<option warning="warning">
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
		</option>
		<setting name="console_application" value="true"/>
		<setting name="dead_code_removal" value="feature"/>
		<capability>
			<concurrency support="scoop"/>
			<void_safety support="all"/>
		</capability>
		<external_include location="$ECF_CONFIG_PATH/Clib"/>
		<external_object location="$(SIMPLE_EIFFEL)/simple_shaping/Clib/simple_shaping_posix.o">
			<condition>
				<platform excluded_value="windows"/>
			</condition>
		</external_object>
		<external_linker_flag value="-L/opt/homebrew/lib -lharfbuzz -lfribidi -lfreetype -lfontconfig -lcairo">
			<condition>
				<platform value="macintosh"/>
			</condition>
		</external_linker_flag>
		<external_linker_flag value="-lharfbuzz -lfribidi -lfreetype -lfontconfig -lcairo">
			<condition>
				<platform value="unix"/>
			</condition>
		</external_linker_flag>
		<library name="base" location="$ISE_LIBRARY\library\base\base.ecf"/>
		<library name="simple_mml" location="$SIMPLE_EIFFEL\simple_mml\simple_mml.ecf"/>
		<library name="simple_cairo" location="$SIMPLE_EIFFEL\simple_cairo\simple_cairo.ecf"/>
		<cluster name="src" location=".\src\" recursive="true">
			<file_rule>
				<description>Off Windows, posix/ replaces the DirectWrite backends and the GDI font classes.</description>
				<exclude>/directwrite$</exclude>
				<exclude>/fonts$</exclude>
				<condition>
					<platform excluded_value="windows"/>
				</condition>
			</file_rule>
		</cluster>
		<cluster name="posix" location=".\posix\">
			<condition>
				<platform excluded_value="windows"/>
			</condition>
		</cluster>
	</target>
	<target name="simple_shaping_tests" extends="simple_shaping">
		<root class="TEST_APP" feature="make"/>
		<option warning="warning">
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
		</option>
		<setting name="console_application" value="true"/>
		<external_include location="$ECF_CONFIG_PATH/Clib"/>
		<library name="simple_testing" location="$SIMPLE_EIFFEL/simple_testing/simple_testing.ecf"/>
		<library name="simple_datetime" location="$SIMPLE_EIFFEL/simple_datetime/simple_datetime.ecf"/>
		<library name="testing" location="$ISE_LIBRARY\library\testing\testing.ecf"/>
		<cluster name="tests" location=".\testing\" recursive="true"/>
	</target>
</system>
